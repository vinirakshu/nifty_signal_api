# ---- Fyers app (create at https://myapi.fyers.in/dashboard) ----
FYERS_CLIENT_ID=TPBRI498ZD-100
FYERS_SECRET_KEY=74EDINT42O
# Must match the Redirect URL set in your Fyers app exactly
FYERS_REDIRECT_URI=http://127.0.0.1:5110/auth/callback
# Optional: paste today's access token instead of using /auth/login-url
FYERS_ACCESS_TOKEN=

# ---- This API ----
PORT=5110
# If set, every /api/* call needs header:  X-API-Key: <value>
API_KEY=

# ---- Instruments ----
NIFTY_INDEX_SYMBOL=NSE:NIFTY50-INDEX
NIFTY_LOT_SIZE=65

# ---- Analysis tuning ----
CANDLE_RESOLUTION=5
OPTION_STRIKE_COUNT=15
LEVEL_CLUSTER_POINTS=20
MIN_RISK_REWARD=1.0
BIAS_THRESHOLD=2
PCR_BULLISH=1.2
PCR_BEARISH=0.8

# ---- Paper trading (virtual money) ----
PAPER_DB=paper_trades.db
# 100 crore
PAPER_START_CAPITAL=1000000000
PAPER_SQUARE_OFF=15:15
PAPER_MONITOR=1
PAPER_MONITOR_SECONDS=15
# Approximate charges - check your broker's current rates
PAPER_BROKERAGE_PER_ORDER=20
PAPER_STT_SELL_PCT=0.1
PAPER_EXCHANGE_PCT=0.03503
PAPER_STAMP_BUY_PCT=0.003
PAPER_GST_PCT=18

# ---- Auto paper trading (all strategies, whole session) ----
AUTO_TRADE_ENABLED=1
AUTO_STRATEGIES=confluence,orb,ema_vwap,oi_bounce
AUTO_CYCLE_SECONDS=30
AUTO_ENTRY_START=09:20
AUTO_ENTRY_END=14:45
AUTO_RISK_PER_TRADE_PCT=0.5
AUTO_MAX_CAPITAL_PER_TRADE_PCT=10
AUTO_MAX_OI_PCT=2
AUTO_MAX_LOTS=5000
AUTO_MAX_TRADES_PER_STRATEGY=6
AUTO_COOLDOWN_MINUTES=10
AUTO_EXIT_AT=T1
AUTO_MONEYNESS=ATM
AUTO_SLIPPAGE_PCT=0.2
AUTO_LOG_DIR=logs

# ---- Live market feed (Nifty 50 board, order book, faster paper exits) ----
FEED_ENABLED=1
FEED_WEBSOCKET=1
FEED_REST_SECONDS=10
